# Anthropic API key (required for meal plans and snack carts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model.
# Default is claude-opus-5-5. For lower cost per plan, use claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Kroger API credentials (optional — demo data used if not set)
# Register at https://developer.kroger.com
# Add http://localhost:8000/api/kroger/callback as a Redirect URI to enable
# digital-coupon pricing via Kroger account sign-in.
KROGER_CLIENT_ID=your_kroger_client_id_here
KROGER_CLIENT_SECRET=your_kroger_client_secret_here
