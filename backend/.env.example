# Anthropic API key (required for meal plans and snack carts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model.
# Default is claude-opus-5-5. For lower cost per plan, use claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Kroger API credentials (optional — demo data used if not set)
# Register at https://developer.kroger.com
# Add http://localhost:8000/api/kroger/callback as a Redirect URI to enable
# digital-coupon pricing via Kroger account sign-in.
KROGER_CLIENT_ID=your_kroger_client_id_here
KROGER_CLIENT_SECRET=your_kroger_client_secret_here

# --- Only needed when running off localhost (phone on your Wi-Fi, or deployed) ---
# Where the browser app is served from. Comma-separate to allow several origins.
# FRONTEND_URL=http://192.168.1.50:5173
# Public URL of THIS backend — used to build the Kroger OAuth redirect.
# BACKEND_URL=http://192.168.1.50:8000
# Or set the redirect explicitly (must match the Kroger developer app exactly):
# KROGER_REDIRECT_URI=https://your-api.example.com/api/kroger/callback
